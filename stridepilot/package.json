{
  "name": "stridepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "validate:engine": "tsc -p tmp/tsconfig.eval.json && node tmp-cjs/scripts/engine-validation.js",
    "validate:engine-v2": "tsc -p tmp/tsconfig.engine-v2.json && node tmp-v2/scripts/engine-v2-validation.js",
    "validate:engine-v2:classification": "tsc -p tmp/tsconfig.engine-v2.json && node tmp-v2/scripts/engine-v2-classification-validation.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/nodemailer": "^7.0.11",
    "next": "16.1.6",
    "nodemailer": "^8.0.3",
    "openai": "^6.27.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.15.0",
    "typescript": "^5"
  }
}
