generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  email        String        @unique
  passwordHash String
  profile      RunnerProfile?
}

model RunnerProfile {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  firstName         String?
  heightCm          Int
  weightKg          Int
  age               Int
  activityLevel     String
  runningExperience String
  currentRunningAbility String?
  gender            String?
  userTrainingContext String?
  currentWeeklyVolumeKm Int?
  currentRunsPerWeek Int?
  longestCurrentRunMin Int?
  recentRaceTimesJson Json?
  injuryHistory     String?
  weakPoints        String?
  realisticTrainingDaysPerWeek Int?
  typicalWorkoutMinutes Int?
  otherTraining     String?
  preferredGuidance String?
  userId            String?            @unique
  user              AppUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  goals             Goal[]
  plans             TrainingPlan[]
  vNextPlans        VNextPlanState[]
  pushSubscriptions PushSubscription[]
  feedbackEntries   WorkoutFeedback[]
  notes             ProfileNote[]
}

model Goal {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  distance     String
  goalType     String?
  weeks        Int
  startDate    DateTime
  endDate      DateTime?
  targetTime   String?
  targetPaceSecPerKm Int?
  availableTrainingDays String[]
  preferredLongRunDay String?
  ambition     String?
  reminderHour Int            @default(7)
  reminderMin  Int            @default(0)

  profileId String
  profile   RunnerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plans     TrainingPlan[]
  vNextPlans VNextPlanState[]

  @@index([profileId])
}

model TrainingPlan {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  summary         String
  weeks           Int
  sessionsPerWeek Int
  source          String
  currentWeek     Int              @default(1)
  rationaleJson   Json?

  profileId String
  profile   RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  sessions WorkoutSession[]
  adaptations TrainingPlanAdaptation[]

  @@index([profileId])
  @@index([goalId])
}

model WorkoutSession {
  loadScore        Int      @default(5)
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  title     String
  week      Int
  dayOfWeek String
  notes     String?
  order     Int

  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  steps      WorkoutStep[]
  deliveries PushDelivery[]
  feedback   WorkoutFeedback[]

  @@index([planId])
}

model WorkoutStep {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        String
  label       String
  durationSec Int
  cue         String
  order       Int

  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  profileId String
  profile   RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  deliveries PushDelivery[]

  @@index([profileId])
}

model PushDelivery {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  scheduledFor     DateTime
  status           String   @default("sent")
  pushSubId        String
  workoutSessionId String

  pushSubscription PushSubscription @relation(fields: [pushSubId], references: [id], onDelete: Cascade)
  workoutSession   WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([pushSubId, workoutSessionId])
  @@index([scheduledFor])
}

model WorkoutFeedback {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  profileId        String
  workoutSessionId String
  quickFeedback    String?
  effort           Int
  completionPct    Int
  energy           Int
  painLevel        Int
  notes            String?
  adaptationFactor Float

  profile       RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([workoutSessionId])
}

model TrainingPlanAdaptation {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mode             String
  reason           String
  runnerFocus      String?
  changeSummaryJson Json?
  weekNumber       Int?
  triggeredBySessionId String?

  planId String
  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model VNextPlanState {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  logicalPlanId        String
  engineVersion        String   @default("vnext")
  currentVersionNumber Int      @default(1)
  latestHistoryEntryId String?

  profileId String
  profile   RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  versions VNextPlanVersion[]
  history  VNextPlanHistory[]

  @@unique([profileId, logicalPlanId])
  @@index([profileId, updatedAt])
  @@index([goalId])
}

model VNextPlanVersion {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  versionNumber          Int
  derivedFromVersionNumber Int?
  isCurrent              Boolean  @default(false)
  snapshotJson           Json
  validationJson         Json?
  versionMetadataJson    Json?
  mutationHistoryJson    Json?

  planStateId String
  planState   VNextPlanState @relation(fields: [planStateId], references: [id], onDelete: Cascade)

  @@unique([planStateId, versionNumber])
  @@index([planStateId, isCurrent])
}

model VNextPlanHistory {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  entryId                String   @unique
  sourceVersionNumber    Int
  resultingVersionNumber Int
  feedbackJson           Json?
  decisionJson           Json?
  mutationJson           Json?
  validationJson         Json?
  applied                Boolean
  fallback               Boolean

  planStateId String
  planState   VNextPlanState @relation(fields: [planStateId], references: [id], onDelete: Cascade)

  @@index([planStateId, createdAt])
}

model ProfileNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  text      String

  profileId String
  profile   RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
