{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "../tmp-cjs"
  },
  "include": [
    "../tmp/planner-eval.ts",
    "../scripts/engine-validation.ts",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "../src/app/**/*",
    "../node_modules"
  ]
}
